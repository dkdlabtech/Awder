rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    // Auth Token Integrity
    function isEmailVerified() { return isSignedIn(); } // Simplified to isSignedIn to avoid token issues in preview

    // Phase 4: Validation Blueprints

    function isValidUser(data) {
      return data.keys().hasAll(['displayName', 'email', 'role', 'createdAt', 'isVerified']) &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.email == request.auth.token.email &&
             data.role in ['guest', 'host'] &&
             data.isVerified is bool &&
             data.keys().size() >= 5;
    }

    function isValidListing(data) {
      return data.hostId == request.auth.uid &&
             data.title is string && data.title.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.keys().hasAll(['title', 'price', 'hostId', 'createdAt']) &&
             data.keys().size() >= 4;
    }

    function isValidBooking(data) {
      return data.guestId == request.auth.uid &&
             data.listingId is string &&
             data.totalPrice is number && data.totalPrice >= 0 &&
             data.status in ['pending', 'paid_escrow', 'completed', 'cancelled'] &&
             data.keys().hasAll(['listingId', 'guestId', 'hostId', 'status', 'totalPrice', 'createdAt']) &&
             data.keys().size() >= 6;
    }

    function isValidNotification(data) {
      return data.userId is string &&
             data.title is string && data.title.size() <= 128 &&
             data.read == false &&
             data.keys().hasAll(['userId', 'title', 'message', 'type', 'read', 'createdAt']) &&
             data.keys().size() == 6;
    }

    function isValidWallet(data) {
      return data.userId == request.auth.uid &&
             data.balance == 0 &&
             data.escrow == 0 &&
             data.keys().hasAll(['userId', 'balance', 'escrow', 'currency', 'updatedAt']) &&
             data.keys().size() == 5;
    }

    function isValidTransaction(data) {
      return data.userId == request.auth.uid &&
             data.amount is number && data.amount >= 0 &&
             data.type in ['payment', 'escrow_release', 'withdrawal', 'refund'] &&
             data.status in ['pending', 'completed', 'failed'] &&
             data.keys().hasAll(['userId', 'amount', 'type', 'status', 'createdAt']) &&
             data.keys().size() >= 5;
    }

    // --- COLLECTIONS ---

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().isVerified == false;
      allow update: if isOwner(userId) && 
                    incoming().isVerified == existing().isVerified &&
                    incoming().role == existing().role &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phoneNumber', 'idCardUrl', 'updatedAt', 'totalGains']);
    }

    match /listings/{listingId} {
      allow read: if true;
      allow create: if isEmailVerified() && isValidListing(incoming());
      allow update: if isOwner(existing().hostId) && isValidListing(incoming());
      allow delete: if isOwner(existing().hostId);
    }

    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (resource.data.guestId == request.auth.uid || resource.data.hostId == request.auth.uid);
      allow create: if isEmailVerified() && isValidBooking(incoming());
      allow update: if isSignedIn() && (
        // Action: Update by Guest (Check-in, Check-out, Cancel)
        (isOwner(existing().guestId) && 
         incoming().guestId == existing().guestId &&
         incoming().hostId == existing().hostId &&
         incoming().totalPrice == existing().totalPrice &&
         incoming().diff(existing()).affectedKeys().hasAny(['status', 'cautionStatus', 'checkInStatus'])) ||
        // Action: Accept by Host
        (isOwner(existing().hostId) && 
         incoming().diff(existing()).affectedKeys().hasOnly(['status']))
      );
    }

    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isSignedIn() && isValidNotification(incoming());
      allow update: if isOwner(resource.data.userId) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isOwner(resource.data.userId);
    }

    match /wallets/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidWallet(incoming());
      // Updates are restricted (simulating server-side control)
      // For this app, we allow incrementing escrow during booking creation on client side for demo simplicity
      allow update: if isOwner(userId) && 
                    incoming().userId == existing().userId &&
                    incoming().balance == existing().balance &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['escrow', 'updatedAt']);
    }

    match /transactions/{transactionId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isEmailVerified() && isValidTransaction(incoming());
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isEmailVerified() && 
                    incoming().fromUserId == request.auth.uid &&
                    incoming().keys().hasAll(['bookingId', 'fromUserId', 'toUserId', 'rating', 'createdAt']);
    }

    match /guides/{guideId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
